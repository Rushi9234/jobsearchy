# ── Email Delivery (Recommended: Resend Free API for Render) ───────────
# Get free API key from https://resend.com (Zero cost, no credit card needed)
RESEND_API_KEY=re_your_free_resend_api_key_here

# ── Fallback SMTP Settings (For local development only) ────────────────
MAIL_FROM=your_gmail@gmail.com
MAIL_PASS=your_gmail_app_password_here
MAIL_TO=recipient@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ── Telegram Notifications ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Cloud Database (Optional: Turso LibSQL for Render persistence) ─────
# Get free DB from https://turso.tech (9GB free, zero pause)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Free LLM Keys (For Resume Parsing, Career GPS & Joby AI) ──────────
GEMINI_API_KEY=
GROQ_API_KEY=